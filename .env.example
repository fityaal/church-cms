# ===== LOCAL DEVELOPMENT / AIVEN =====
FLASK_ENV=production
SECRET_KEY=CHANGE-ME-to-a-long-random-secret

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=church_user
MYSQL_PASSWORD=CHANGE-ME
MYSQL_DB=church_cms

# For Aiven, set MYSQL_SSL=true. For local MySQL, false is usually fine.
MYSQL_SSL=false
MYSQL_SSL_VERIFY=false
# Optional: paste the Aiven CA PEM into MYSQL_SSL_CA_PEM for certificate verification.
MYSQL_SSL_CA_PEM=

# Optional email
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxx

# Production bootstrap
SEED_DEFAULTS=false
INITIAL_ADMIN_MOBILE=
INITIAL_ADMIN_NAME=Church Administrator
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=CHANGE-ME

# Optional upload location (not required for receipt PDFs, which are generated in memory)
UPLOAD_FOLDER=
